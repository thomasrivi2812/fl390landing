# Copier ce fichier en `.env.local` (non versionné) et renseigner les valeurs.
# Sur Vercel, les déclarer dans Project Settings → Environment Variables.

# URL publique de la landing. Sert aux métadonnées absolues (Open Graph), au
# sitemap et à robots.txt. Sans elle, tout retombe sur http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL publique de la boutique (dépôt FL390). Tous les boutons « Boutique »,
# les cartes du drop et les liens du pied de page pointent dessus.
NEXT_PUBLIC_SHOP_URL=https://fl390.paris

# Endpoint d'inscription à la liste d'embarquement (Brevo, Mailchimp, Klaviyo,
# Resend Audiences, webhook maison…). Reçoit un POST JSON `{ "email": "…" }`.
# Tant qu'elle est absente, /api/newsletter répond 503 et le formulaire affiche
# un message d'indisponibilité — plutôt que de perdre des adresses en silence.
# NEWSLETTER_WEBHOOK_URL=
