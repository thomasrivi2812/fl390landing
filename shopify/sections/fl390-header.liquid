{% comment %}
  FL390 — En-tête minimal : le logotype centré, rien d'autre.
  À placer dans le groupe « header » du personnalisateur à la place de
  l'en-tête et de la barre d'annonce du thème.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s = section.settings
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Krona+One&family=Titillium+Web:wght@600;700&display=swap">

<style>
  #fl390-header-{{ sid }} {
    display: flex; align-items: center; justify-content: center;
    height: {{ s.height }}px; padding: 0 22px;
    background: #000000; color: #fdfdfd;
    {% if s.show_border %}border-bottom: 1px solid rgba(253, 253, 253, 0.16);{% endif %}
    -webkit-font-smoothing: antialiased;
  }
  #fl390-header-{{ sid }} .fl-wordmark {
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    color: inherit; text-decoration: none;
  }
  #fl390-header-{{ sid }} .fl-wordmark__mark { font-family: 'Krona One', sans-serif; font-size: {{ s.mark_size }}px; line-height: 1; }
  #fl390-header-{{ sid }} .fl-wordmark__city {
    font-family: 'Titillium Web', sans-serif; font-weight: 600; font-size: 8px; line-height: 1;
    letter-spacing: 0.62em; text-indent: 0.62em; text-transform: uppercase;
  }
</style>

<header id="fl390-header-{{ sid }}">
  <a class="fl-wordmark" href="{{ routes.root_url }}" aria-label="{{ s.mark }} {{ s.city }} — accueil">
    <span class="fl-wordmark__mark">{{ s.mark }}</span>
    <span class="fl-wordmark__city">{{ s.city }}</span>
  </a>
</header>

{% schema %}
{
  "name": "FL390 — En-tête",
  "tag": "div",
  "class": "fl390-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "mark", "label": "Logotype", "default": "FL390" },
    { "type": "text", "id": "city", "label": "Ville", "default": "PARIS" },
    { "type": "range", "id": "mark_size", "label": "Taille du logotype", "min": 16, "max": 32, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "height", "label": "Hauteur", "min": 56, "max": 96, "step": 4, "unit": "px", "default": 72 },
    { "type": "checkbox", "id": "show_border", "label": "Filet sous l'en-tête", "default": false }
  ],
  "presets": [{ "name": "FL390 — En-tête" }]
}
{% endschema %}
