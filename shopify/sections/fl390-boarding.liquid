{% comment %}
  FL390 — Boarding soon
  Section autonome : fond animé de codes OACI, tableau des départs à volets,
  titre « BOARDING SOON », compte à rebours, liste d'embarquement (formulaire
  client Shopify, tag « newsletter »). Tout se règle dans le personnalisateur.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign codes = 'CDG,LHR,JFK,LAX,DXB,HND,NRT,SIN,FRA,AMS,HKG,PEK,SYD,GVA,ORD,BOS,MIA,YUL,MAD,BCN' | split: ','
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Krona+One&family=Titillium+Web:wght@400;600;700&family=Work+Sans:wght@400;500;600&display=swap">

<style>
  #fl390-{{ sid }} {
    --fl-ink: #000000;
    --fl-paper: #fdfdfd;
    --fl-burgundy: #6d1111;
    --fl-display: 'Krona One', sans-serif;
    --fl-body: 'Work Sans', sans-serif;
    --fl-label: 'Titillium Web', sans-serif;
    font-family: var(--fl-body);
    -webkit-font-smoothing: antialiased;
  }
  #fl390-{{ sid }} *, #fl390-{{ sid }} *::before, #fl390-{{ sid }} *::after { box-sizing: border-box; }
  #fl390-{{ sid }} p, #fl390-{{ sid }} h1, #fl390-{{ sid }} h2, #fl390-{{ sid }} ul { margin: 0; }
  #fl390-{{ sid }} ul { list-style: none; padding: 0; }
  #fl390-{{ sid }} .fl-label {
    font-family: var(--fl-label); font-weight: 700; font-size: 9px;
    letter-spacing: 0.3em; text-transform: uppercase;
  }

  /* ---------- Hero ---------- */
  #fl390-{{ sid }} .fl-hero {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center;
    min-height: {{ s.hero_height }}svh;
    padding: 26px 14px clamp(30px, 5vw, 60px);
    background: var(--fl-ink); color: var(--fl-paper);
  }
  @media (min-width: 560px) { #fl390-{{ sid }} .fl-hero { padding-left: 22px; padding-right: 22px; } }

  /* Fond animé : colonnes de codes qui dérivent */
  #fl390-{{ sid }} .fl-drift {
    pointer-events: none; user-select: none; position: absolute; inset: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 8px; padding: 0 8px; overflow: hidden;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 35%, transparent 78%);
    mask-image: radial-gradient(ellipse at center, #000 35%, transparent 78%);
  }
  @media (min-width: 760px) { #fl390-{{ sid }} .fl-drift { grid-template-columns: repeat(6, 1fr); } }
  #fl390-{{ sid }} .fl-drift__col {
    display: flex; flex-direction: column;
    font-family: var(--fl-label); font-weight: 600; font-size: 11px; letter-spacing: 0.34em;
    color: rgba(253, 253, 253, 0.11);
    animation: fl-drift-{{ sid }} 60s linear infinite;
  }
  #fl390-{{ sid }} .fl-drift__col:nth-child(even) { animation-direction: reverse; }
  #fl390-{{ sid }} .fl-drift__col:nth-child(n + 4) { display: none; }
  @media (min-width: 760px) { #fl390-{{ sid }} .fl-drift__col:nth-child(n + 4) { display: flex; } }
  #fl390-{{ sid }} .fl-drift__run { display: flex; flex-direction: column; align-items: center; gap: 46px; padding: 23px 0; }
  @keyframes fl-drift-{{ sid }} { from { transform: translateY(0); } to { transform: translateY(-50%); } }

  #fl390-{{ sid }} .fl-wordmark {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 3px;
    color: inherit; text-decoration: none;
  }
  #fl390-{{ sid }} .fl-wordmark__mark { font-family: var(--fl-display); font-size: 22px; line-height: 1; }
  #fl390-{{ sid }} .fl-wordmark__city {
    font-family: var(--fl-label); font-weight: 600; font-size: 8px; line-height: 1;
    letter-spacing: 0.62em; text-indent: 0.62em;
  }

  #fl390-{{ sid }} .fl-hero__body {
    position: relative; display: flex; flex: 1; align-items: center; justify-content: center;
    width: 100%; padding-top: clamp(26px, 4vw, 48px);
  }

  /* ---------- Tableau ---------- */
  #fl390-{{ sid }} .fl-board {
    width: 100%; max-width: 1120px; overflow: hidden;
    border: 1px solid rgba(253, 253, 253, 0.16); border-radius: 14px;
    background: #0a0a0a; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  #fl390-{{ sid }} .fl-board__pad { padding-left: clamp(14px, 2.4vw, 28px); padding-right: clamp(14px, 2.4vw, 28px); }
  #fl390-{{ sid }} .fl-board__top {
    display: none; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
    padding-top: 14px; padding-bottom: 14px; border-bottom: 1px solid rgba(253, 253, 253, 0.16);
    font-family: var(--fl-label); font-weight: 700; font-size: 10px; letter-spacing: 0.34em; text-transform: uppercase;
  }
  #fl390-{{ sid }} .fl-board__top .fl-dim { color: rgba(253, 253, 253, 0.4); }
  #fl390-{{ sid }} .fl-board__meta { display: flex; align-items: center; gap: 14px; letter-spacing: 0.24em; color: rgba(253, 253, 253, 0.6); }
  #fl390-{{ sid }} .fl-accent { color: var(--fl-burgundy); }
  #fl390-{{ sid }} .fl-row {
    display: none; grid-template-columns: 58px minmax(64px, 0.6fr) 1.6fr 48px minmax(132px, 0.9fr);
    align-items: center; column-gap: 12px;
  }
  #fl390-{{ sid }} .fl-row--head { padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid rgba(253, 253, 253, 0.16); color: rgba(253, 253, 253, 0.4); }
  #fl390-{{ sid }} .fl-row--flight { padding-top: 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(253, 253, 253, 0.1); color: rgba(253, 253, 253, 0.38); }
  #fl390-{{ sid }} .fl-row--featured { color: var(--fl-paper); }
  #fl390-{{ sid }} .fl-cell { font-family: var(--fl-label); font-weight: 600; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; }
  #fl390-{{ sid }} .fl-cell--num { font-variant-numeric: tabular-nums; }
  @media (min-width: 640px) {
    #fl390-{{ sid }} .fl-board__top { display: flex; }
    #fl390-{{ sid }} .fl-row { display: grid; }
  }

  /* Volets */
  #fl390-{{ sid }} .fl-flap {
    position: relative; display: inline-flex; align-items: center; justify-content: center; overflow: hidden;
    border: 1px solid rgba(253, 253, 253, 0.12); border-radius: 4px; background: #141414;
  }
  #fl390-{{ sid }} .fl-flap::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(0, 0, 0, 0.85); }
  #fl390-{{ sid }} .fl-flap--status {
    padding: 5px 9px; border-color: var(--fl-burgundy); background: var(--fl-burgundy);
    font-size: 10px; letter-spacing: 0.2em; color: var(--fl-paper);
  }
  #fl390-{{ sid }} .fl-flap--status::after { background: rgba(0, 0, 0, 0.4); }
  #fl390-{{ sid }} .fl-flap.is-flipping { animation: fl-flap-{{ sid }} 320ms ease-out both; transform-origin: 50% 50%; }
  @keyframes fl-flap-{{ sid }} { from { transform: rotateX(-90deg); opacity: 0.4; } to { transform: rotateX(0); opacity: 1; } }

  /* Titre */
  #fl390-{{ sid }} .fl-title-block { display: flex; flex-direction: column; gap: 18px; padding-top: clamp(26px, 4vw, 44px); }
  #fl390-{{ sid }} .fl-eyebrow { color: rgba(253, 253, 253, 0.5); letter-spacing: 0.32em; }
  #fl390-{{ sid }} .fl-title { display: flex; flex-wrap: wrap; gap: 6px clamp(12px, 2vw, 24px); font-weight: 400; line-height: 1; }
  #fl390-{{ sid }} .fl-title__word { display: inline-flex; gap: 3px; }
  #fl390-{{ sid }} .fl-title .fl-flap {
    font-family: var(--fl-display); font-size: clamp(1.75rem, 8.4vw, 4.2rem);
    height: 1.45em; width: 1.06em; color: var(--fl-paper);
  }

  /* Compte à rebours */
  #fl390-{{ sid }} .fl-count-block { display: flex; flex-direction: column; gap: 16px; padding-top: clamp(22px, 3vw, 34px); padding-bottom: clamp(22px, 3.5vw, 40px); }
  #fl390-{{ sid }} .fl-count-block > .fl-label { color: rgba(253, 253, 253, 0.4); }
  #fl390-{{ sid }} .fl-count { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16px clamp(10px, 2.4vw, 26px); }
  #fl390-{{ sid }} .fl-count__group { display: flex; align-items: flex-start; gap: clamp(10px, 2.4vw, 26px); }
  #fl390-{{ sid }} .fl-count__unit { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  #fl390-{{ sid }} .fl-count__tiles { display: inline-flex; gap: 3px; }
  #fl390-{{ sid }} .fl-count .fl-flap {
    font-family: var(--fl-display); font-size: clamp(1.5rem, 6.4vw, 3.6rem); line-height: 1;
    height: 1.55em; width: 1.05em; color: var(--fl-paper); font-variant-numeric: tabular-nums;
  }
  #fl390-{{ sid }} .fl-count__label { color: rgba(253, 253, 253, 0.5); }
  #fl390-{{ sid }} .fl-count__sep { font-family: var(--fl-display); font-size: clamp(1.5rem, 6.4vw, 3.6rem); line-height: 1; margin-top: 0.32em; color: rgba(253, 253, 253, 0.35); }

  #fl390-{{ sid }} .fl-board__foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
    padding-top: 12px; padding-bottom: 12px; border-top: 1px solid rgba(253, 253, 253, 0.16);
    color: rgba(253, 253, 253, 0.4); letter-spacing: 0.26em;
  }

  /* ---------- Liste d'embarquement ---------- */
  #fl390-{{ sid }} .fl-news { padding: clamp(48px, 7vw, 96px) 22px; background: var(--fl-paper); color: var(--fl-ink); }
  #fl390-{{ sid }} .fl-news__inner { display: flex; flex-direction: column; align-items: center; gap: 24px; max-width: 860px; margin: 0 auto; text-align: center; }
  #fl390-{{ sid }} .fl-news__eyebrow { color: var(--fl-burgundy); letter-spacing: 0.32em; }
  #fl390-{{ sid }} .fl-news__title { font-family: var(--fl-display); font-weight: 400; font-size: clamp(1.25rem, 2.6vw, 1.9rem); line-height: 1.1; letter-spacing: -0.02em; }
  #fl390-{{ sid }} .fl-news__text { max-width: 46ch; font-size: 14px; line-height: 1.75; color: rgba(0, 0, 0, 0.6); }
  #fl390-{{ sid }} .fl-news__form { width: 100%; max-width: 460px; padding-top: 8px; }
  #fl390-{{ sid }} .fl-news__pill {
    display: flex; align-items: center; padding: 4px 6px 4px 20px;
    border: 1px solid rgba(0, 0, 0, 0.3); border-radius: 999px; background: var(--fl-paper); transition: border-color 300ms ease;
  }
  #fl390-{{ sid }} .fl-news__pill:focus-within { border-color: var(--fl-ink); }
  #fl390-{{ sid }} .fl-news__input {
    flex: 1; min-width: 0; padding: 12px 0; border: 0; background: transparent; outline: none;
    font-family: var(--fl-label); font-size: 14px; color: var(--fl-ink);
  }
  #fl390-{{ sid }} .fl-news__input::placeholder { color: rgba(0, 0, 0, 0.4); }
  #fl390-{{ sid }} .fl-news__button {
    padding: 12px 20px; border: 0; border-radius: 999px; background: rgba(0, 0, 0, 0.9); color: var(--fl-paper); cursor: pointer;
    font-family: var(--fl-label); font-weight: 700; font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; white-space: nowrap;
    transition: background-color 300ms ease;
  }
  #fl390-{{ sid }} .fl-news__button:hover { background: var(--fl-burgundy); }
  #fl390-{{ sid }} .fl-news__status { margin-top: 14px; min-height: 1.6em; font-size: 13px; line-height: 1.6; color: rgba(0, 0, 0, 0.6); }
  #fl390-{{ sid }} .fl-news__status--error { color: var(--fl-burgundy); }
  #fl390-{{ sid }} .fl-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    #fl390-{{ sid }} *, #fl390-{{ sid }} *::before, #fl390-{{ sid }} *::after { animation: none !important; transition: none !important; }
  }
</style>

<div id="fl390-{{ sid }}" data-launch="{{ s.launch_date | escape }}">
  <section class="fl-hero">
    {%- if s.show_background -%}
      <div class="fl-drift" aria-hidden="true">
        {%- for column in (0..5) -%}
          {%- assign offset = column | times: 3 -%}
          {%- assign duration = column | times: 9 | plus: 52 -%}
          <div class="fl-drift__col" style="animation-duration: {{ duration }}s;">
            {%- for run in (1..2) -%}
              <span class="fl-drift__run">
                {%- for i in (0..19) -%}
                  {%- assign index = i | plus: offset | modulo: 20 -%}
                  <span>{{ codes[index] }}</span>
                {%- endfor -%}
              </span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.show_wordmark -%}
      <a class="fl-wordmark" href="{{ routes.root_url }}" aria-label="FL390 Paris">
        <span class="fl-wordmark__mark">FL390</span>
        <span class="fl-wordmark__city">PARIS</span>
      </a>
    {%- endif -%}

    <div class="fl-hero__body">
      <div class="fl-board">
        <div class="fl-board__top fl-board__pad">
          <span>{{ s.board_title }} <span class="fl-dim">— {{ s.board_subtitle }}</span></span>
          <span class="fl-board__meta">
            <span>{{ s.board_airport }}</span>
            <span class="fl-accent">✳</span>
            <span class="fl-clock" data-clock>––:––:––</span>
          </span>
        </div>

        <div class="fl-row fl-row--head fl-board__pad">
          <span class="fl-label">Heure</span>
          <span class="fl-label">Vol</span>
          <span class="fl-label">Destination</span>
          <span class="fl-label">Porte</span>
          <span class="fl-label">Statut</span>
        </div>

        <ul>
          {%- for block in section.blocks -%}
            <li class="fl-row fl-row--flight fl-board__pad" {{ block.shopify_attributes }}>
              <span class="fl-cell fl-cell--num">{{ block.settings.time }}</span>
              <span class="fl-cell">{{ block.settings.flight }}</span>
              <span class="fl-cell">{{ block.settings.destination }}</span>
              <span class="fl-cell">{{ block.settings.gate }}</span>
              <span class="fl-cell">{{ block.settings.status }}</span>
            </li>
          {%- endfor -%}
          <li class="fl-row fl-row--flight fl-row--featured fl-board__pad">
            <span class="fl-cell fl-cell--num">——:——</span>
            <span class="fl-cell">{{ s.featured_flight }}</span>
            <span class="fl-cell">{{ s.featured_destination }}</span>
            <span class="fl-cell">{{ s.featured_gate }}</span>
            <span class="fl-cell"><span class="fl-flap fl-flap--status">{{ s.featured_status }}</span></span>
          </li>
        </ul>

        <div class="fl-title-block fl-board__pad">
          <p class="fl-label fl-eyebrow">
            {{ s.eyebrow_flight }} <span class="fl-accent">✳</span>
            {{ s.eyebrow_gate }} <span class="fl-accent">✳</span>
            {{ s.eyebrow_date_prefix }} {{ s.launch_date_label }}
          </p>
          <h1 class="fl-title" aria-label="{{ s.title | escape }}">
            {%- assign words = s.title | upcase | split: ' ' -%}
            {%- for word in words -%}
              <span class="fl-title__word" aria-hidden="true">
                {%- assign letters = word | split: '' -%}
                {%- for letter in letters -%}<span class="fl-flap">{{ letter }}</span>{%- endfor -%}
              </span>
            {%- endfor -%}
          </h1>
        </div>

        <div class="fl-count-block fl-board__pad">
          <span class="fl-label">{{ s.countdown_label }}</span>
          <div class="fl-count" role="timer" aria-label="Temps restant avant l'embarquement">
            {%- assign units = 'days:Jours,hours:Heures,minutes:Minutes,seconds:Secondes' | split: ',' -%}
            {%- for unit in units -%}
              {%- assign pair = unit | split: ':' -%}
              <div class="fl-count__group">
                <div class="fl-count__unit">
                  <span class="fl-count__tiles" data-unit="{{ pair[0] }}">
                    <span class="fl-flap">–</span><span class="fl-flap">–</span>
                  </span>
                  <span class="fl-label fl-count__label">{{ pair[1] }}</span>
                </div>
                {%- unless forloop.last -%}<span class="fl-count__sep" aria-hidden="true">:</span>{%- endunless -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="fl-board__foot fl-board__pad fl-label">
          <span>{{ s.foot_left }}</span>
          <span>{{ s.foot_right }}</span>
        </div>
      </div>
    </div>
  </section>

  {%- if s.show_newsletter -%}
    <section class="fl-news" id="embarquement">
      <div class="fl-news__inner">
        <span class="fl-label fl-news__eyebrow">{{ s.news_eyebrow }}</span>
        <h2 class="fl-news__title">{{ s.news_title }}</h2>
        <p class="fl-news__text">{{ s.news_text }}</p>
        {%- assign form_id = 'fl390-newsletter-' | append: sid -%}
        {%- form 'customer', id: form_id, class: 'fl-news__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="fl390-email-{{ sid }}" class="fl-sr">Adresse email</label>
          <div class="fl-news__pill">
            <input
              id="fl390-email-{{ sid }}"
              class="fl-news__input"
              type="email"
              name="contact[email]"
              required
              autocomplete="email"
              placeholder="{{ s.news_placeholder | escape }}"
              value="{{ form.email }}"
            >
            <button type="submit" class="fl-news__button">{{ s.news_button }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="fl-news__status" role="status">{{ s.news_success }}</p>
          {%- elsif form.errors -%}
            <p class="fl-news__status fl-news__status--error" role="alert">{{ form.errors | default_errors }}</p>
          {%- else -%}
            <p class="fl-news__status">{{ s.news_note }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('fl390-{{ sid }}');
    if (!root) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var target = Date.parse(root.getAttribute('data-launch') || '');

    function setTile(tile, character) {
      if (tile.textContent === character) return;
      tile.textContent = character;
      if (reduce) return;
      tile.classList.remove('is-flipping');
      void tile.offsetWidth;
      tile.classList.add('is-flipping');
    }

    function setUnit(name, value) {
      var holder = root.querySelector('[data-unit="' + name + '"]');
      if (!holder) return;
      var text = String(value);
      if (text.length < 2) text = '0' + text;
      while (holder.children.length < text.length) {
        var extra = document.createElement('span');
        extra.className = 'fl-flap';
        extra.textContent = '–';
        holder.appendChild(extra);
      }
      for (var i = 0; i < holder.children.length; i++) {
        setTile(holder.children[i], text[i] || '');
      }
    }

    function tick() {
      if (isNaN(target)) return;
      var total = Math.max(0, Math.floor((target - Date.now()) / 1000));
      setUnit('days', Math.floor(total / 86400));
      setUnit('hours', Math.floor((total % 86400) / 3600));
      setUnit('minutes', Math.floor((total % 3600) / 60));
      setUnit('seconds', total % 60);
    }

    var clock = root.querySelector('[data-clock]');
    var formatter = null;
    try {
      formatter = new Intl.DateTimeFormat('fr-FR', {
        hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Europe/Paris'
      });
    } catch (error) { formatter = null; }

    function tickClock() {
      if (clock && formatter) clock.textContent = formatter.format(new Date());
    }

    tick();
    tickClock();
    setInterval(function () { tick(); tickClock(); }, 1000);

    /* Après l'envoi du formulaire, Shopify recharge la page en haut :
       on ramène le visiteur sur le message de confirmation ou d'erreur. */
    var status = root.querySelector('.fl-news__status[role]');
    if (status && (window.location.search.indexOf('customer_posted=true') !== -1 || status.classList.contains('fl-news__status--error'))) {
      var news = root.querySelector('.fl-news');
      if (news) news.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    }
  })();
</script>

{% schema %}
{
  "name": "FL390 — Boarding soon",
  "tag": "section",
  "class": "fl390-section",
  "settings": [
    { "type": "header", "content": "Compte à rebours" },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Date d'embarquement (ISO 8601)",
      "default": "2026-10-07T00:00:00+02:00",
      "info": "Format AAAA-MM-JJTHH:MM:SS+02:00. Le fuseau doit être indiqué (+02:00 en été, +01:00 en hiver pour Paris)."
    },
    { "type": "text", "id": "launch_date_label", "label": "Date affichée", "default": "7 octobre 2026" },
    { "type": "text", "id": "countdown_label", "label": "Libellé du compte à rebours", "default": "Embarquement dans" },

    { "type": "header", "content": "Titre" },
    { "type": "text", "id": "title", "label": "Titre en volets", "default": "BOARDING SOON", "info": "Une tuile par lettre, la ligne casse entre les mots." },
    { "type": "text", "id": "eyebrow_flight", "label": "Surtitre — vol", "default": "Vol FL 390" },
    { "type": "text", "id": "eyebrow_gate", "label": "Surtitre — porte", "default": "Porte 01" },
    { "type": "text", "id": "eyebrow_date_prefix", "label": "Surtitre — avant la date", "default": "Embarquement le" },

    { "type": "header", "content": "Tableau des départs" },
    { "type": "text", "id": "board_title", "label": "Titre du bandeau", "default": "Départs" },
    { "type": "text", "id": "board_subtitle", "label": "Sous-titre du bandeau", "default": "Departures" },
